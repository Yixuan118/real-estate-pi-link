{
  "name": "Real Estate Monitor",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "forwardPorts": [3742],
  "portsAttributes": {
    "3742": {
      "label": "Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
